<div class="flex justify-center items-center h-dvh bg-base-200 w-full">
  <div class="flex flex-col min-w-[75%] xl:min-w-[35%]">
    <%= if @banner_url do %>
      <div
        class="object-cover h-full w-full w-10 aspect-[2.5] -mb-4 rounded-t-lg"
        style={"background: url(\"#{@banner_url}\"); background-position: center; background-size: cover;"}
      />
    <% end %>
    <div class="bg-base-300 items-center flex flex-col gap-1 p-5 rounded-lg">
      <div class="h-16 w-16 rounded-full bg-green-700 overflow-hidden">
        <img class="object-cover" src={@avatar_url} />
      </div>
      <div class="select-none">
        Welcome, <span class="font-bold">{@display_name || @user_name}</span>!
      </div>
      <div class="mt-4">
        Your matrix profile already exists with the following username:
      </div>
      <div class="font-mono bg-base-100 p-2 rounded-md">
        {"@#{@user_name}:#{Cfg.get(:matrix_delegate)}"}
      </div>
      <div class="mt-8">
        If you are having trouble accessing your account, please contact an administrator via <a
          class="link link-primary"
          href={Cfg.get(:misskey_host)}
        >{Cfg.get(
          :misskey_name
        )}</a>.
      </div>

      <a
        class="btn btn-primary mt-8"
        href={"#{Cfg.get(:matrix_client)}/login/#{Cfg.get(:matrix_delegate)}?username=#{@user_name}"}
      >
        Continue to Matrix
      </a>
    </div>
  </div>
</div>
